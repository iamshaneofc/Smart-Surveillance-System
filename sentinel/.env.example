# SENTINEL foundation - local environment
# Copy to .env and adjust. NEVER commit real .env files.

# --- application ---
SENTINEL_ENV=dev
SENTINEL_LOG_LEVEL=INFO
SENTINEL_LOG_JSON=false

# --- API ---
SENTINEL_API_HOST=127.0.0.1
SENTINEL_API_PORT=8000

# --- database ---
# Default is SQLite so the foundation runs without Docker.
# docker-compose overrides this with PostgreSQL.
SENTINEL_DATABASE_URL=sqlite:///./var/sentinel.db

# --- event bus ---
# memory:// for single-process dev; redis://localhost:6379/0 in compose
SENTINEL_BUS_URL=memory://

# --- auth ---
# disabled = local dev only (anonymous admin, warning logged)
# api_key  = X-API-Key header, keys configured below
SENTINEL_AUTH_MODE=disabled
# SENTINEL_AUTH_API_KEYS=[{"key": "dev-key-change-me", "user": "operator1", "roles": ["operator"]}]

SENTINEL_RATE_LIMIT_PER_MINUTE=120

# --- evidence ---
SENTINEL_EVIDENCE_PRE_SECONDS=10
SENTINEL_EVIDENCE_POST_SECONDS=10
SENTINEL_EVIDENCE_ROOT=./var/evidence

# --- camera defaults ---
SENTINEL_CAMERA_DEFAULT_DETECTION_FPS=5
SENTINEL_CAMERA_RECONNECT_INITIAL_SECONDS=1
SENTINEL_CAMERA_RECONNECT_MAX_SECONDS=30
